# ── Required ──────────────────────────────────────────────────────────
# MySQL connection string.
# Format: mysql://<user>:<password>@<host>:<port>/<database>
#
# Examples:
#   Local:   mysql://root:***@localhost:3306/ai_tools_hub
#   Docker:  mysql://aitools:***@127.0.0.1:3306/ai_tools_hub
#   Remote:  mysql://aitools:***@your-server-ip:3306/ai_tools_hub
DATABASE_URL=mysql://user:password@host:port/ai_tools_hub

# ── Optional ──────────────────────────────────────────────────────────
# Microlink API key for enhanced metadata fetching (screenshots, etc.).
# Without this, the free endpoint is used (rate-limited).
# Get one at https://microlink.io
MICROLINK_API_KEY=

# Token required by the browser extension to write (create cards, fetch metadata).
# Reads stay public and the same-origin web admin UI is unaffected.
# Leave empty for local-only dev (enforcement is skipped).
# Set a long random string before exposing the app publicly.
# Generate one with: openssl rand -hex 32
EXTENSION_API_TOKEN=
